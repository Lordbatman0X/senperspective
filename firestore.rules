rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'kadersdiaz3@gmail.com' ||
        request.auth.token.email == 'admin@perspective.sn'
      );
    }

    // Public News Content: Anyone can read published articles, media, and site settings
    match /articles/{articleId} {
      allow read: if true;
      allow write: if true;
    }

    match /media/{mediaId} {
      allow read: if true;
      allow write: if true;
    }

    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    match /matches/{matchId} {
      allow read: if true;
      allow write: if true;
    }

    match /ads/{adId} {
      allow read: if true;
      allow write: if true;
    }

    // Comments: Anyone can read, readers can submit comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Newsletter Subscribers & Dispatches
    match /subscribers/{subscriberId} {
      allow read, write: if true;
    }

    match /dispatches/{dispatchId} {
      allow read, write: if true;
    }

    match /reports/{reportId} {
      allow read, write: if true;
    }

    // Users and Social Profiles (Registration, Login, Friends, Follows)
    match /users/{userEmail} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated() || isAdmin();

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // Direct Messages between members
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Telemetry & Consent Events
    match /analytics_events/{eventId} {
      allow read, write: if true;
    }

    match /user_consents/{consentId} {
      allow read, write: if true;
    }

    match /daily_analytics/{date} {
      allow read, write: if true;
    }

    match /analytics_archive/{archiveId} {
      allow read, write: if true;
    }

    // Default safety deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
