rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isOwnerByEmail(userEmail) {
      return isSignedIn() && request.auth.token.email != null && 
        request.auth.token.email.toLowerCase() == userEmail.toLowerCase();
    }

    function isOwnerByUid(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "kadersdiaz3@gmail.com" ||
        request.auth.token.email == "admin@perspective.sn" ||
        request.auth.token.email.matches(".*admin.*")
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Collection: Users (User accounts, profiles & cross-device preferences)
    match /users/{userEmail} {
      allow read: if true; // Public profile viewing & cross-device preference loading
      allow create: if true; // User registration
      allow update: if true; // Allow user preference updates & profile syncing across devices
      allow delete: if isSignedIn() && (isOwnerByEmail(userEmail) || isAdmin());
    }

    // Collection: Guest Preferences (Anonymous device-level sync)
    match /guest_preferences/{deviceId} {
      allow read, write: if true;
    }

    // Collection: Articles
    match /articles/{articleId} {
      allow read: if true; // Public read for all news readers
      allow create, update, delete: if isSignedIn();
    }

    // Collection: Comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if true; // Readers can submit comments
      allow update, delete: if isSignedIn();
    }

    // Collection: Messages (Direct Messaging & Messenger Sync)
    match /messages/{messageId} {
      allow read: if true; // Real-time message synchronization across bubble, drawer, and fullscreen
      allow create: if true; // Direct messages and AI responses
      allow update, delete: if true; // Mark as read and message deletion
    }

    // Collection: Media (Asset Library)
    match /media/{mediaId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Collection: Ads (Banner Ads & Sponsorship)
    match /ads/{adId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Collection: Site Settings
    match /siteSettings/{configId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Collection: Matches (Sports Scores & Matches)
    match /matches/{matchId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Collection: Subscribers (Newsletter)
    match /subscribers/{subscriberId} {
      allow read: if isSignedIn();
      allow create: if true; // Newsletter subscription
      allow update, delete: if isSignedIn();
    }

    // Collection: Analytics Events
    match /analytics_events/{eventId} {
      allow read: if isSignedIn();
      allow create: if true; // Telemetry event logging
      allow update, delete: if isSignedIn();
    }

    // Collection: User Consents (Privacy & Cookie Choices)
    match /user_consents/{consentId} {
      allow read: if isSignedIn();
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    // Collection: Daily Analytics Summary
    match /daily_analytics/{dateId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Collection: Password Reset Logs
    match /password_resets/{resetId} {
      allow read: if isSignedIn();
      allow create, update: if true;
      allow delete: if isSignedIn();
    }
  }
}
