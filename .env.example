# Optional: comma-separated admin master keys (legacy escape hatch).
# SECURITY: these were previously hardcoded in source and have been removed.
# Leave unset in production so only password-hash verification applies.
# VITE_MASTER_KEYS=

# Frontend (Vite) - used by src/lib/supabaseClient.ts
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server (Express) - used by server.ts and src/lib/firestoreServer.ts
# Use the service_role key here (NEVER expose to browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# MongoDB Atlas (new primary database — replaces Supabase)
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=perspective

# Google OAuth (Web application client id) â€” required by the Newsletter admin to
# connect a Gmail account and send campaigns. WITHOUT this, "Connect Google"
# cannot work: it fails immediately with a missing-client-id error.
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# (type: Web application). Add your domains under "Authorized JavaScript origins":
#   https://ai-studio-applet-webapp-29e84.web.app
#   https://senperspective.com
#   http://localhost:3000   (local dev)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
