    "admins": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.email === 'kadersdiaz3@gmail.com' || auth.token.email === 'admin@senperspective.com')"
    },

    "users": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || newData.child('email').val() === auth.token.email || (auth.token.email === 'kadersdiaz3@gmail.com' || auth.token.email === 'admin@senperspective.com'))",
        "role": {
          ".validate": "(auth != null && (auth.token.email === 'kadersdiaz3@gmail.com' || auth.token.email === 'admin@senperspective.com')) || !newData.exists() || newData.val() === data.val()"
        },
        "suspended": {
          ".validate": "(auth != null && (auth.token.email === 'kadersdiaz3@gmail.com' || auth.token.email === 'admin@senperspective.com')) || !newData.exists() || newData.val() === data.val()"
        },
        "suspendedAt": {
          ".validate": "(auth != null && (auth.token.email === 'kadersdiaz3@gmail.com' || auth.token.email === 'admin@senperspective.com')) || !newData.exists() || newData.val() === data.val()"
        }
      }
    },

