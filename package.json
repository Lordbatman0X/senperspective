{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:header-nav": "esbuild src/lib/siteTaxonomy.ts --bundle --format=esm --platform=neutral --outfile=.navtest.mjs --log-level=error && node scripts/test-header-nav.mjs",
    "test:carousel": "esbuild scripts/test-carousel.mjs --bundle --format=esm --platform=node --outfile=.carouseltest.mjs --log-level=error && node .carouseltest.mjs",
    "test:newsroom": "esbuild scripts/test-newsroom.mjs --bundle --format=cjs --platform=node --define:import.meta.env={} --outfile=.newstest.cjs --log-level=error && node .newstest.cjs",
    "test:api-utils": "esbuild scripts/test-api-utils.mjs --bundle --format=esm --platform=node --define:import.meta.env={} --outfile=.apiutilstest.mjs --log-level=error && node .apiutilstest.mjs",
    "test:curated-rows": "node --experimental-strip-types scripts/test-curated-rows.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "firebase": "^12.15.0",
    "idb-keyval": "^6.2.5",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "opentype.js": "^2.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-easy-crop": "^6.2.3",
    "react-image-crop": "^11.1.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.16.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "browserslist": "^4.29.0",
    "firebase-admin": "^14.4.0",
    "lightningcss": "^1.33.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
